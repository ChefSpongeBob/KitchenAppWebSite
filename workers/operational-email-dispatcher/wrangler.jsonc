{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crimini-operational-email-dispatcher",
  "main": "index.js",
  "compatibility_date": "2026-02-07",
  "workers_dev": false,
  "vars": {
    "APP_BASE_URL": "https://criminiops.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crimini-production",
      "database_id": "ae576972-bfc0-49fa-8fa2-80ddcffa2f5c"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
